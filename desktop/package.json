{
  "name": "interview-desktop",
  "productName": "FUCKINTERVIEW",
  "version": "0.0.1",
  "private": true,
  "description": "FUCKINTERVIEW 桌面端：Electron 外壳 + 本地 Python 服务",
  "author": "hu-qi-jia",
  "main": "electron/main.js",
  "scripts": {
    "start": "electron .",
    "dev": "electron . --dev",
    "backend": "python scripts/build-backend.py",
    "clean": "node scripts/clean-build.js",
    "dist": "npm run backend && node scripts/clean-build.js dist && electron-builder --win nsis",
    "release-check": "python scripts/release-check.py",
    "test": "node --test electron/*.test.js"
  },
  "devDependencies": {
    "electron": "44.8.0",
    "electron-builder": "^26.18.0"
  },
  "build": {
    "appId": "com.fuckinterview.desktop",
    "productName": "FUCKINTERVIEW",
    "copyright": "FUCKINTERVIEW",
    "directories": {
      "output": "dist",
      "buildResources": "build"
    },
    "files": [
      "electron/**/*",
      "!electron/*.test.js",
      "package.json"
    ],
    "extraResources": [
      {
        "from": "resources/backend",
        "to": "backend"
      }
    ],
    "win": {
      "target": [
        {
          "target": "nsis",
          "arch": [
            "x64"
          ]
        }
      ],
      "icon": "build/icon.ico",
      "artifactName": "FUCKINTERVIEW-Setup-${version}.${ext}"
    },
    "nsis": {
      "oneClick": false,
      "perMachine": false,
      "allowElevation": true,
      "allowToChangeInstallationDirectory": true,
      "createDesktopShortcut": true,
      "createStartMenuShortcut": true,
      "shortcutName": "FUCKINTERVIEW",
      "artifactName": "FUCKINTERVIEW-Setup-${version}.${ext}",
      "deleteAppDataOnUninstall": false
    }
  }
}
