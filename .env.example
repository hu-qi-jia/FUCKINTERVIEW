# 复制为 .env 后填写。最小可用链路需要：一个 STT + 一个 LLM + 一个 TTS。
# 注意：examples 里用 load_dotenv() 从当前工作目录向上查找 .env，请在项目根目录运行。

# ---------- STT 语音识别 ----------
DEEPGRAM_API_KEY=

# ---------- LLM 大模型 ----------
OPENAI_API_KEY=
ANTHROPIC_API_KEY=

# ---------- TTS 语音合成 ----------
CARTESIA_API_KEY=
CARTESIA_VOICE_ID=
ELEVENLABS_API_KEY=
ELEVENLABS_VOICE_ID=

# ---------- 中文可选 ----------
# QWEN_API_KEY=
# MINIMAX_API_KEY=
# MINIMAX_GROUP_ID=
# AZURE_SPEECH_API_KEY=
# AZURE_SPEECH_REGION=

# ---------- 运行参数 ----------
# runner 默认监听 7860；限制允许的 Origin 时用逗号分隔
# PIPECAT_ALLOWED_ORIGINS=
